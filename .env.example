# Copy to .env and fill in. .env is ignored by git — never commit real values,
# and never paste them into chat, email or tickets.

# Public address of the live site (no trailing slash)
SITE_URL=https://walnutdatatech.com

# FTP account used by `npm run deploy`
FTP_HOST=
FTP_USER=
FTP_PASS=''
# Folder on the server that is the website root, relative to the FTP login folder.
# Leave empty to use the login folder (or public_html when it exists).
FTP_DIR=

# Razorpay API keys (Dashboard → Account & Settings → API keys).
# Test keys start with rzp_test_, live keys with rzp_live_.
# The secret is uploaded to the server only (api/config.php); it never reaches the browser or the repository.
# Live keys are refused until legal.refundPolicy is filled in site.config.mjs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio email — an API key pair (Console → Account → API keys & tokens). Starts with SK.
# Do NOT put the account's primary auth token here; it is not needed.
# The secret is uploaded to the server only (api/config.php).
TWILIO_API_KEY=
TWILIO_API_SECRET=
# The address emails are sent from. Its domain must be verified for sending in Twilio.
EMAIL_FROM=support@walnutdatatech.com
EMAIL_FROM_NAME='Walnut Data Tech'
# Where enquiries and enrolment notifications are delivered.
EMAIL_NOTIFY=support@walnutdatatech.com

# Onboarding Tool — where a University's "Request a consultation" is filed for admin review.
# Only the University journey (the solution configurator) uses this; the contact form, course
# checkout and partner applications never do.
# The public https address of the Onboarding Tool, no trailing slash. Leave empty to switch this off:
# University enquiries then reach the team by email only, exactly as before.
# (http://localhost:4000 works with `npm run dev`; the deploy script refuses to publish a localhost address.)
ONBOARDING_API_URL=
# Shared secret — the same value as UNIVERSITY_REQUEST_API_KEY in the Onboarding Tool's server/.env.
# Uploaded to the server only (api/config.php); it never reaches the browser.
ONBOARDING_API_KEY=

# Walnut accounts (login/ and dashboard/) kept in the web host's own MySQL database.
# Used when ONBOARDING_API_URL is empty. Login and the dashboard are published once DB_NAME, DB_USER,
# ACCOUNT_SECRET and the email settings above are filled in. The tables (wa_*) are created on first use.
# DB_HOST is as the web server sees the database — usually localhost.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=''
# Signs sessions and one-time codes. Generate once with:  openssl rand -hex 32
# Changing it signs everyone out. Uploaded to the server only (api/config.php).
ACCOUNT_SECRET=
# Codes by SMS (optional): the Twilio Account SID (AC…) and a sender — a Twilio phone number (+1…)
# or a Messaging Service SID (MG…). While SMS_FROM is empty, login offers the email code only.
TWILIO_ACCOUNT_SID=
SMS_FROM=

# One sign-in for the other Walnut apps (api/sso.php): a secret per app (openssl rand -hex 32), the same value
# as WALNUT_SSO_SECRET in that app. An app without one is not offered on the dashboard.
WALNUT_SSO_SECRET_ONBOARDING=
WALNUT_SSO_SECRET_COURSE_FINDER=
WALNUT_SSO_SECRET_LEADS=
# Walnut LMS (the LMS's own name for the same value is WALNUT_SSO_SECRET): the sign-in the Enrol and Continue
# buttons use. While it is empty, Enrol opens the course on Walnut LMS and the learner signs in there.
WALNUT_SSO_SECRET_LMS=

# Walnut LMS — where courses are sold and taken. The site lists its catalogue at /academy/ and shows each
# learner's progress on their dashboard. Its public https address, with no path and no trailing slash (this
# is the default); the deploy stops on anything else.
WALNUT_LMS_URL=https://walnut-lms.vercel.app
# Signs our server's calls to the LMS (course progress). openssl rand -hex 32 — the same value as
# WALNUT_INTEGRATION_SECRET in the LMS's Vercel settings; both sides must hold the same value, or progress
# is not shown. Uploaded to the server only (api/config.php); it never reaches the browser.
WALNUT_LMS_INTEGRATION_SECRET=
# 1 hands the courses bought on this website before the LMS sold them to the LMS, once each, so those
# learners have them there. Leave empty until the LMS team confirms they receive these purchases. The
# hand-over runs after a signed-in person's dashboard has loaded: up to 10 purchases every two minutes, so it
# finishes as people use their dashboards (check: SELECT COUNT(*) FROM wa_enrolments WHERE lms_synced_at IS NULL).
WALNUT_LMS_BACKFILL=
